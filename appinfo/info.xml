<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>my_xrechnung</id>
    <name>meine X-Rechnung</name>
    <summary>erstellt neue X-Rechnung</summary>
    <description>fragt Parameter in GUI ab, setzt diese in XML- und ODT-Templates, druckt in PDF und bindet XML ein</description>
    <version>0.1.1</version>
    <licence>AGPL-3.0-or-later</licence>
    <author>Frank Busse</author>
    <namespace>MyXRechnung</namespace>
    <category>tools</category>

    <dependencies>
        <nextcloud min-version="34" max-version="34" />
    </dependencies>

    <navigations>
      <navigation>
        <name>meine X-Rechnung</name>
        <route>my_xrechnung.page.index</route>
        <icon>app.svg</icon>
        <order>10</order>
      </navigation>
    </navigations>

    <repair-steps>
        <install>
            <step>OCA\MyXRechnung\Migration\InstallValidator</step>
        </install>
    </repair-steps>

    <settings>
        <admin>OCA\MyXRechnung\Settings\Admin</admin>
        <admin-section>OCA\MyXRechnung\Settings\AdminSection</admin-section>
    </settings>
</info>
